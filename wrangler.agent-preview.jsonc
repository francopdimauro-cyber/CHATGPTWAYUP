// Worker de los chats PUBLICADOS de los agentes (widget.js y /api/chats/*), preview autorizada de WAY UP Studio.
// Uso: npm run deploy:agent-preview  (prueba y despliega SOLO este Worker).
// Comparte la base de datos D1 con el Studio. No apunta a producción ni a los Workers originales.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wayup-studio-agent-preview",
  "main": "src/studio-public-agent-worker.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "STUDIO_DB",
      "database_name": "wayup-studio-preview-projects",
      "database_id": "e9008ba7-8572-4506-b4e4-f7f6a21fb5d2"
    }
  ],
  "vars": {
    // Modelos de los chats publicados, en orden (claves como secretos de ESTE Worker: GROQ_API_KEY, OPENROUTER_API_KEY).
    "STUDIO_AGENT_MODELS": "groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free",
    // "off": los chats publicados solo usan los modelos externos (claves guardadas como secretos de este Worker).
    "STUDIO_WORKERS_AI": "off"
  },
  "observability": { "enabled": true }
}
